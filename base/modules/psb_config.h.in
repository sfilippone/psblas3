  typedef int64_t psb_e_t;

  typedef float  psb_s_t;
  typedef double psb_d_t;

#ifdef  __cplusplus
   typedef std::complex<float> psb_c_t;
   typedef std::complex<double> psb_z_t;
#else
   typedef float complex psb_c_t;
   typedef double complex psb_z_t;
#endif

